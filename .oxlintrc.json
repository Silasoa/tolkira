{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**",
    ".opencode/**",
    "coverage/**",
    ".openchamber/**"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "warn"
  },
  "rules": {
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectStep",
          "expectRejectedTarget",
          "expectNoSidecar",
          "validatePair"
        ]
      }
    ],
    "eslint/no-underscore-dangle": [
      "warn",
      { "allow": ["__tolkiraXss", "__tolkiraCopied"] }
    ],
    "eslint/no-redeclare": "warn",
    "eslint/no-promise-executor-return": "warn",
    "eslint/eqeqeq": "warn",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-depth": "off",
    "eslint/max-statements": "off",
    "import/max-dependencies": "off",
    "eslint/require-unicode-regexp": "off",
    "unicorn/escape-case": "off",
    "unicorn/no-useless-undefined": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/explicit-length-check": "off",
    "unicorn/prefer-dom-node-dataset": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/prefer-single-call": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/prefer-at": "off",
    "unicorn/no-hex-escape": "off",
    "unicorn/prefer-dom-node-append": "off",
    "unicorn/prefer-import-meta-properties": "off",
    "eslint/no-await-in-loop": "off",
    "vitest/no-conditional-in-test": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "vitest/no-conditional-expect": "off",
    "oxc/no-map-spread": "off",
    "unicorn/prefer-set-has": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-return": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/no-confusing-void-expression": "off",
    "typescript/switch-exhaustiveness-check": "off",
    "typescript/no-deprecated": "off",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/strict-void-return": "off",
    "typescript/require-await": "off"
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "eslint/require-await": "off"
      }
    },
    {
      "files": ["src/stream.ts", "src/compat/cucumber-html-reporter.ts"],
      "rules": {
        "promise/no-callback-in-promise": "off"
      }
    },
    {
      "files": ["src/compat/cucumber-html-reporter.cts"],
      "rules": {
        "eslint/no-shadow": "off"
      }
    },
    {
      "files": ["src/render/html.ts"],
      "rules": {
        "eslint/require-await": "off"
      }
    }
  ]
}
