{
  "name": "tolkira",
  "version": "0.2.0",
  "description": "Self-contained offline HTML reports for Cucumber legacy JSON, Messages and JUnit XML, with a stable JSON summary for CI and AI agents.",
  "type": "module",
  "license": "MIT",
  "author": "Tolkira contributors",
  "homepage": "https://github.com/Silasoa/tolkira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silasoa/tolkira.git"
  },
  "bugs": {
    "url": "https://github.com/Silasoa/tolkira/issues"
  },
  "keywords": [
    "cucumber",
    "cucumber-json",
    "cucumber-messages",
    "cucumber-html-reporter",
    "multiple-cucumber-html-reporter",
    "html-formatter",
    "junit",
    "junit-xml",
    "gherkin",
    "bdd",
    "html-report",
    "test-report",
    "report-generator",
    "offline",
    "ci",
    "agent",
    "llm",
    "testing"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tolkira": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat/cucumber-html-reporter": {
      "import": {
        "types": "./dist/compat/cucumber-html-reporter.d.ts",
        "default": "./dist/compat/cucumber-html-reporter.js"
      },
      "require": {
        "types": "./dist/compat/cucumber-html-reporter.d.cts",
        "default": "./dist/compat/cucumber-html-reporter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "DESIGN.md",
    "LICENSE",
    "SECURITY.md",
    "docs/AGENT-INTERFACE.md",
    "docs/COMPATIBILITY.md",
    "docs/CUCUMBER-COMPATIBILITY.md",
    "docs/JUNIT-XML.md",
    "docs/LIMITATIONS.md",
    "GLOSSARY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run assets && node esbuild.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.compat-cjs.json",
    "postbuild": "node scripts/copy-compat-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "npm run assets && vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/build-styles.mjs && node scripts/build-search.mjs",
    "styles": "node scripts/build-styles.mjs",
    "prestress": "npm run build",
    "stress": "node scripts/stress.mjs",
    "check": "npm run assets && npm run typecheck && npm run lint && npm run build && npm run test",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@cucumber/messages": "^34.2.1",
    "fast-xml-parser": "^5.12.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@cucumber/tag-expressions": "^11.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
